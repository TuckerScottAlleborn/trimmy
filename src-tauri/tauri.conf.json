{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trimmy",
  "version": "0.1.0",
  "identifier": "io.github.tuckerscottalleborn.trimmy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Trimmy",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0d0e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Tucker Scott Alleborn",
    "copyright": "Copyright (c) 2026 Tucker Scott Alleborn. MIT License.",
    "homepage": "https://github.com/TuckerScottAlleborn/trimmy",
    "category": "Video",
    "shortDescription": "Comically simple video trimmer",
    "longDescription": "Open a video, drag the start and end, export. Lossless and fast. Made for game clips.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "resources": {
      "../LICENSE": "licenses/Trimmy-LICENSE.txt",
      "bin/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
