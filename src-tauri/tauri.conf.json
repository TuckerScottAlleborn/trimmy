{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trimmy",
  "version": "0.2.0",
  "identifier": "io.github.tuckerscottalleborn.trimmy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Trimmy",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0d0e",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQjhDOTI4QTU2MTMyRUYKUldUdk1tR2xLTW00NEtjdmRiblNEM2JaeUE1cEpUYllISldhRVRybXRQQ0hrRjhjTnlaTGR1VUwK",
      "endpoints": ["https://github.com/TuckerScottAlleborn/trimmy/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Tucker Scott Alleborn",
    "copyright": "Copyright (c) 2026 Tucker Scott Alleborn. MIT License.",
    "homepage": "https://github.com/TuckerScottAlleborn/trimmy",
    "category": "Video",
    "shortDescription": "A video trimmer. That's it.",
    "longDescription": "Open a video, drag the start and end, export. Lossless and fast. Made with game clips in mind; works on just about any video.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "resources": {
      "../LICENSE": "licenses/Trimmy-LICENSE.txt",
      "bin/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
